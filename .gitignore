# Quartz build output
public/

# Quartz is cloned fresh at build time (scripts/build-site.sh) — not vendored
quartz/

# OS files
.DS_Store

# Secrets
.env

# Obsidian workspace state (local paths)
.obsidian/workspace.json

# Large binary reference files (not needed for the deployed wiki)
# Source documents are converted to markdown in wiki/raw/ — the markdown is
# the committed source of truth; the binary originals stay local only.
*.pptx
*.docx
*.zip
*.vtt

# One-off scripts
_extract_pptx.py
